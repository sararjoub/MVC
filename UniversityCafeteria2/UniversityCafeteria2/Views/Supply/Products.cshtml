@{
}


@{
    string[] products = (string[])ViewData["Products"];
}

<div class="container mt-5">

    <h2 class="mb-4">@ViewData["Title"]</h2>

    <div class="card p-3 mb-3">
        <h4>Manager Name</h4>
        <p>@ViewData["Manager"]</p>
    </div>

    <div class="card p-3 mb-3">
        <h4>Total Products</h4>
        <p>@ViewData["TotalProducts"]</p>
    </div>

    <div class="card p-3">
        <h4>Products List</h4>

        <ul>
            @foreach (string product in products)
            {
                <li>@product</li>
            }
        </ul>
    </div>

</div>
