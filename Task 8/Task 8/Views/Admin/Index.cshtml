
@model List<Task_8.Models.ApplicationUser>

<h2>Manage Users</h2>

<table class="table table-bordered">
    <tr>
        <th>Full Name</th>
        <th>Email</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FullName</td>
            <td>@item.Email</td>

            <td>
                <a asp-controller="Admin"
                   asp-action="Edit"
                   asp-route-id="@item.Id">
                    Edit Role
                </a>

                @if (item.Id != User.FindFirst(
                    System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                {
                    <form asp-controller="Admin"
                          asp-action="Delete"
                          asp-route-id="@item.Id"
                          method="post"
                          style="display:inline">

                        <button type="submit"
                                onclick="return confirm('Delete this user?')">
                            Delete
                        </button>
                    </form>
                }
            </td>
        </tr>
    }
</table>
