
@model Task_8.Models.SupplyRequest

<h2>Edit Supply Request</h2>

<form asp-controller="SupplyRequest"
      asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post">

    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
    {
        <label>Status</label>

        <select name="Status">
            @foreach (var status in new[] { "Pending", "Approved", "Rejected" })
            {
                if (status == Model.Status)
                {
                    <option value="@status" selected>@status</option>
                }
                else
                {
                    <option value="@status">@status</option>
                }
            }
        </select>
    }
    else
    {
        @foreach (var item in Model.RequestItems.OrderBy(i => i.Id))
        {
            <p>Product ID: @item.ProductId</p>

            <input type="hidden"
                   name="ItemIds"
                   value="@item.Id" />

            <label>Quantity</label>

            <input type="number"
                   name="Quantities"
                   value="@item.Quantity"
                   min="1" />

            <hr />
        }
    }

    <button type="submit">Save Changes</button>
</form>

<a asp-controller="SupplyRequest" asp-action="Index">
    Back
</a>
