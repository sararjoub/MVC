
@model Task_8.Models.Product

<h2>Edit Product</h2> 

<form asp-controller="Product" asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />   <!-- هذا السطر بيخلي رقم المنتج موجود داخل الفورم، لكنه مخفي عن المستخدم.-->

    <div asp-validation-summary="All" class="text-danger"></div>

    <label>Name</label>
    <input asp-for="Name" />
    <br />

    <label>Description</label>
    <input asp-for="Description" />
    <br />

    <label>Price</label>
    <input asp-for="Price" type="number" step="0.01" />
    <br />

    <label>Quantity</label>
    <input asp-for="Quantity" type="number" />
    <br />

    <button type="submit">Save Changes</button>

</form>
