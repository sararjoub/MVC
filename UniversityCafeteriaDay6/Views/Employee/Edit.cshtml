@{
}

@model UniversityCafeteriaDay6.Models.Employee

<h2>Edit Employee</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(x => x.Id) <!-- بخزّن رقم الموظف داخل الفورم حتى نعرف أي موظف بدنا نعدّل.-->

    @Html.LabelFor(x => x.FullName)
    @Html.TextBoxFor(x => x.FullName) <!-- بيعرض القيم القديمة تلقائيًا، وبنقدر نغيّرها-->
    <br />

    @Html.LabelFor(x => x.Phone)
    @Html.TextBoxFor(x => x.Phone)
    <br />

    @Html.LabelFor(x => x.Email)
    @Html.TextBoxFor(x => x.Email)
    <br />

    @Html.LabelFor(x => x.Position)
    @Html.TextBoxFor(x => x.Position)
    <br />

    @Html.LabelFor(x => x.Salary)
    @Html.TextBoxFor(x => x.Salary, new { type = "number", step = "0.01" })
    <br />

    @Html.LabelFor(x => x.HireDate)
    @Html.TextBoxFor(x => x.HireDate, "{0:yyyy-MM-dd}",
        new { type = "date" })
    <br />

    <button type="submit">Save Changes</button>
}
