@{
}
@model List<UniversityCafeteriaDay6.Models.Employee>

<h2>Employees</h2>

@Html.ActionLink("Add Employee", "Create")

<table class="table table-bordered">
    <tr>
        <th>Id</th>
        <th>Full Name</th>
        <th>Phone</th>
        <th>Email</th>
        <th>Position</th>
        <th>Salary</th>
        <th>Hire Date</th>
<th>Orders Count</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.FullName</td>
            <td>@item.Phone</td>
            <td>@item.Email</td>
            <td>@item.Position</td>
            <td>@item.Salary</td>
            <td>@item.HireDate.ToShortDateString()</td>

<td>
    @(((List<UniversityCafeteriaDay6.Models.Order>)ViewBag.Orders).Count(o => o.EmployeeId == item.Id))
</td>

            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.Id })
                @Html.ActionLink("Details", "Details", new { id = item.Id })

                @using (Html.BeginForm("Delete", "Employee",
                                        new { id = item.Id }, FormMethod.Post))
                {
                    <button type="submit"
                    onclick="return confirm('Are you sure?')">
                        Delete
                    </button>
                }
            </td>
        </tr>
    }
</table>