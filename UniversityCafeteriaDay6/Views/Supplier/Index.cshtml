@{
}

@model List<UniversityCafeteriaDay6.Models.Supplier>

<h2>Suppliers List</h2>

<a href="@Url.Action("Create", "Supplier")"
   class="btn btn-primary mb-3">
    Add Supplier
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Address</th>
            <th>Products Count</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.Id</td>
                <td>@supplier.Name</td>
                <td>@supplier.Phone</td>
                <td>@supplier.Email</td>
                <td>@supplier.Address</td>
                
<td>
    @(((List<UniversityCafeteriaDay6.Models.Product>)ViewBag.Products).Count(p => p.SupplierId == supplier.Id))
</td>

                <td>
    @Html.ActionLink("Edit", "Edit", new { id = supplier.Id })
</td>
            </tr>
        }
    </tbody>
</table>
