@{
}

@model List<UniversityCafeteriaDay6.Models.Category>

<h2>Categories</h2>

<a href="@Url.Action("Create", "Category")"
   class="btn btn-primary mb-3">
    Add Category
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
                <td>@category.Description</td>
            </tr>
        }
    </tbody>
</table>
