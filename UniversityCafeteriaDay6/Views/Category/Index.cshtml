@model List<UniversityCafeteriaDay6.Models.Category>

<h2>Categories</h2>

<a href="@Url.Action("Create", "Category")"
   class="btn btn-primary mb-3">
    Add Category
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Products Count</th>
            <th>Actions</th>
            
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>
                    @(((List<UniversityCafeteriaDay6.Models.Product>)ViewBag.Products).Count(p => p.CategoryId == item.Id))
                </td>

                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id })

                    @Html.ActionLink("Details", "Details", new { id = item.Id })


                    @using (Html.BeginForm("Delete", "Category",
                        new { id = item.Id }, FormMethod.Post))
                    {
                        <button type="submit"
                                onclick="return confirm('Are you sure?')">
                            Delete
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
