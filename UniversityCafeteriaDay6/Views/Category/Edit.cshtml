@{
}

@model UniversityCafeteriaDay6.Models.Category

<h2>Edit Category</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(x => x.Id)
    // هذا HTML Helper بعمل 
    //Input مخفي يحتوي على رقم الـ Category
    // لما نضغط Save Changes لازم الـ Controller يعرف أي Category بدنا نعدّلها
    @Html.LabelFor(x => x.Name)
    @Html.TextBoxFor(x => x.Name)

    <br />

    @Html.LabelFor(x => x.Description)
    @Html.TextBoxFor(x => x.Description)

    <br />

    <button type="submit">Save Changes</button>
}