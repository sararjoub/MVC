@{
}

@model UniversityCafeteriaDay6.Models.Order

<h2>Edit Order</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(x => x.Id)

    @Html.LabelFor(x => x.CustomerName)
    @Html.TextBoxFor(x => x.CustomerName)
    <br />

    @Html.LabelFor(x => x.OrderDate)
    @Html.TextBoxFor(x => x.OrderDate, "{0:yyyy-MM-dd}",
        new { type = "date" })
    <br />

    @Html.LabelFor(x => x.TotalPrice)
    @Html.TextBoxFor(x => x.TotalPrice,
        new { type = "number", step = "0.01" })
    <br />

    @Html.LabelFor(x => x.Status)
    @Html.TextBoxFor(x => x.Status)
    <br />

    @Html.LabelFor(x => x.EmployeeId)
    @Html.DropDownListFor(x => x.EmployeeId,
        new SelectList(ViewBag.Employees, "Id", "FullName"))
    <br />

    <button type="submit">Save Changes</button>
}
