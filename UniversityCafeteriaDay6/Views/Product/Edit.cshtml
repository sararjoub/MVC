@{
}

@model UniversityCafeteriaDay6.Models.Product

<h2>Edit Product</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(x => x.Id)

    @Html.LabelFor(x => x.Name)
    @Html.TextBoxFor(x => x.Name)
    <br />

    @Html.LabelFor(x => x.Description)
    @Html.TextBoxFor(x => x.Description)
    <br />

    @Html.LabelFor(x => x.Price)
    @Html.TextBoxFor(x => x.Price)
    <br />

    @Html.LabelFor(x => x.Quantity)
    @Html.TextBoxFor(x => x.Quantity)
    <br />

    @Html.LabelFor(x => x.CategoryId)
    @Html.DropDownListFor(x => x.CategoryId,
        new SelectList(ViewBag.Categories, "Id", "Name"))
    <br />

    @Html.LabelFor(x => x.SupplierId)
    @Html.DropDownListFor(x => x.SupplierId,
        new SelectList(ViewBag.Suppliers, "Id", "Name"))
    <br />

    <button type="submit">Save Changes</button>
}
