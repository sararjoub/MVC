@{
}


@model List<GraduationSupplyManagement.Models.SupplyOffer>

@{
    ViewData["Title"] = "Review Request";
}

<div class="container mt-4">

    <h2>Review Supply Request</h2>

    <table class="table table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Supplier</th>
                <th>Offer</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total Price</th>
            </tr>
        </thead>

        <tbody>

            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>@Model[i].SupplierName</td>
                    <td>@Model[i].OfferName</td>
                    <td>@Model[i].Quantity</td>
                    <td>@Model[i].UnitPrice JD</td>
                    <td>@ViewBag.OfferTotals[i] JD</td>
                </tr>
            }

        </tbody>
    </table>

    <h5>Total Price: @ViewBag.Total JD</h5>

    <h5>Discount: @ViewBag.Discount %</h5>

    <h5>Discount Amount: @ViewBag.DiscountAmount JD</h5>

    <h4>Final Total: @ViewBag.FinalTotal JD</h4>

    <a href="@Url.Action("Index", "Supply")"
       class="btn btn-primary mt-3">
        Back to Offers
    </a>

</div>

